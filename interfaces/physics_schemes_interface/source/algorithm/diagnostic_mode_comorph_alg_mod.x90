    call map_scalar_field(cor_sol_su_coarse, cor_sol_su)
    call map_scalar_field(cor_sol_bc_coarse, cor_sol_bc)
    call map_scalar_field(cor_sol_om_coarse, cor_sol_om)
    call map_scalar_field(cor_sol_ss_coarse, cor_sol_ss)
    call map_scalar_field(n_ait_ins_coarse, n_ait_ins)
    call map_scalar_field(ait_ins_bc_coarse, ait_ins_bc)
    call map_scalar_field(ait_ins_om_coarse, ait_ins_om)
    call map_scalar_field(n_acc_ins_coarse, n_acc_ins)
    call map_scalar_field(acc_ins_du_coarse, acc_ins_du)
    call map_scalar_field(n_cor_ins_coarse, n_cor_ins)
    call map_scalar_field(cor_ins_du_coarse, cor_ins_du)
   ! Microphysics 
    call map_scalar_field(tnuc_coarse, tnuc)
    call map_scalar_field(precfrac_coarse, precfrac)
    call map_scalar_field(ls_rain_coarse, ls_rain)
    call map_scalar_field(ls_snow_coarse, ls_snow)

    call log_event( 'Calling conv_comorph_kernel', LOG_LEVEL_INFO )
    ! call the scheme
    call invoke( conv_comorph_kernel_type( outer, rho_coarse, rho_in_wth_coarse,                                        &
                          wetrho_in_w3_coarse, wetrho_in_wth_coarse, exner_coarse, exner_in_wth_coarse,                 &
                          delta, theta_coarse, u_in_w3_coarse, v_in_w3_coarse, w_in_wth_coarse,                  &
                          theta_star_coarse, u_in_w3_star_coarse, v_in_w3_star_coarse,                                  &
                          height_w3, height_wth,                                                                        &
                          dt_conv_coarse, dmv_conv_coarse, dmcl_conv_coarse,                                            &
                          dms_conv_coarse, du_conv_coarse, dv_conv_coarse,                                              &
                          conv_prog_dtheta_coarse, conv_prog_dmv_coarse,                                                &
                          mr_n_coarse(imr_v), mr_n_coarse(imr_cl), mr_n_coarse(imr_ci),                                 &
                          mr_n_coarse(imr_r), mr_n_coarse(imr_g), mr_n_coarse(imr_s),                                   &
                          mr_coarse(imr_v), mr_coarse(imr_cl), mr_coarse(imr_ci),                                       &
                          mr_coarse(imr_r), mr_coarse(imr_g), mr_coarse(imr_s),                                         &
                          cf_fro_coarse, cf_liq_coarse, cf_bulk_coarse, cca_coarse, ccw_coarse, precfrac_coarse,        &
                          cf_liq_n_coarse, cf_fro_n_coarse, cf_bulk_n_coarse,                                           &
                          cape_diluted_coarse, cca_2d_coarse,                                                           &
                          dd_mf_cb_coarse, massflux_up_coarse, massflux_down_coarse, tke_bl_coarse,                     &
                          pressure_inc_env_coarse,                                                                      &
                          zh_coarse, zh_nonloc_coarse, inv_depth_coarse, zhsc_coarse, bl_type_ind_coarse,               &
                          wvar_coarse, rhokm_bl_coarse, moist_flux_coarse, heat_flux_coarse, taux_coarse, tauy_coarse,  &
                          surf_interp_coarse, ustar_coarse, ls_rain_coarse, ls_snow_coarse,                             &
                          dcfl_conv_coarse, dcff_conv_coarse, dbcf_conv_coarse,                                         &
                          o3p_coarse,                                                                                   &
                          o1d_coarse,                                                                                   &
                          o3_coarse,                                                                                    &
                          n_coarse,                                                                                     &
                          no_coarse,                                                                                    &
                          no3_coarse,                                                                                   &
                          lumped_n_coarse,                                                                              &
                          n2o5_coarse,                                                                                  &
                          ho2no2_coarse,                                                                                &
                          hono2_coarse,                                                                                 &
                          h2o2_coarse,                                                                                  &
                          ch4_coarse,                                                                                   &
                          co_coarse,                                                                                    &
                          hcho_coarse,                                                                                  &
                          meoo_coarse,                                                                                  &
                          meooh_coarse,                                                                                 &
                          h_coarse,                                                                                     &
                          oh_coarse,                                                                                    &
                          ho2_coarse,                                                                                   &
                          cl_coarse,                                                                                    &
                          cl2o2_coarse,                                                                                 &
                          clo_coarse,                                                                                   &
                          oclo_coarse,                                                                                  &
                          br_coarse,                                                                                    &
                          lumped_br_coarse,                                                                             &
