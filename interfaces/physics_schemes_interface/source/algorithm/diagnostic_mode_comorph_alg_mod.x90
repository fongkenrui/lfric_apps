    type( field_type ), pointer :: c3h8 => null()
    type( field_type ), pointer :: n_proo => null()
    type( field_type ), pointer :: i_proo => null()
    type( field_type ), pointer :: n_prooh => null()
    type( field_type ), pointer :: i_prooh => null()
    type( field_type ), pointer :: etcho => null()
    type( field_type ), pointer :: etco3 => null()
    type( field_type ), pointer :: me2co => null()
    type( field_type ), pointer :: mecoch2oo => null()
    type( field_type ), pointer :: mecoch2ooh => null()
    type( field_type ), pointer :: ppan => null()
    type( field_type ), pointer :: meono2 => null()
    type( field_type ), pointer :: c5h8 => null()
    type( field_type ), pointer :: iso2 => null()
    type( field_type ), pointer :: isooh => null()
    type( field_type ), pointer :: ison => null()
    type( field_type ), pointer :: macr => null()
    type( field_type ), pointer :: macro2 => null()
    type( field_type ), pointer :: macrooh => null()
    type( field_type ), pointer :: mpan => null()
    type( field_type ), pointer :: hacet => null()
    type( field_type ), pointer :: mgly => null()
    type( field_type ), pointer :: nald => null()
    type( field_type ), pointer :: hcooh => null()
    type( field_type ), pointer :: meco3h => null()
    type( field_type ), pointer :: meco2h => null()
    type( field_type ), pointer :: h2 => null()
    type( field_type ), pointer :: meoh => null()
    type( field_type ), pointer :: msa => null()
    type( field_type ), pointer :: nh3 => null()
    type( field_type ), pointer :: cs2 => null()
    type( field_type ), pointer :: csul => null()
    type( field_type ), pointer :: h2s => null()
    type( field_type ), pointer :: so3 => null()
    type( field_type ), pointer :: passive_o3 => null()
    type( field_type ), pointer :: age_of_air => null()

    type( field_type ), pointer :: dms => null()
    type( field_type ), pointer :: so2 => null()
    type( field_type ), pointer :: h2so4 => null()
    type( field_type ), pointer :: dmso => null()
    type( field_type ), pointer :: monoterpene => null()
    type( field_type ), pointer :: secondary_organic => null()

    type( field_type ), pointer :: n_nuc_sol => null()
    type( field_type ), pointer :: nuc_sol_su => null()
    type( field_type ), pointer :: nuc_sol_om => null()
    type( field_type ), pointer :: n_ait_sol => null()
    type( field_type ), pointer :: ait_sol_su => null()
    type( field_type ), pointer :: ait_sol_bc => null()
    type( field_type ), pointer :: ait_sol_om => null()
    type( field_type ), pointer :: n_acc_sol => null()
    type( field_type ), pointer :: acc_sol_su => null()
    type( field_type ), pointer :: acc_sol_bc => null()
    type( field_type ), pointer :: acc_sol_om => null()
    type( field_type ), pointer :: acc_sol_ss => null()
    type( field_type ), pointer :: n_cor_sol => null()
    type( field_type ), pointer :: cor_sol_su => null()
    type( field_type ), pointer :: cor_sol_bc => null()
    type( field_type ), pointer :: cor_sol_om => null()
    type( field_type ), pointer :: cor_sol_ss => null()
    type( field_type ), pointer :: n_ait_ins => null()
    type( field_type ), pointer :: ait_ins_bc => null()
    type( field_type ), pointer :: ait_ins_om => null()
    type( field_type ), pointer :: n_acc_ins => null()
    type( field_type ), pointer :: acc_ins_du => null()
    type( field_type ), pointer :: n_cor_ins => null()
    type( field_type ), pointer :: cor_ins_du => null()

    type( field_type ), pointer :: tnuc => null()
    type( field_type ), pointer :: precfrac => null()
    type( field_type ), pointer :: ls_rain => null()
    type( field_type ), pointer :: ls_snow => null()

    type( field_type ), pointer :: height_w3 => null()
    type( field_type ), pointer :: height_wth => null()

    ! Coarsened fields to be passed to CoMorph kernel
    type( field_type ) :: rho_coarse 
    type( field_type ) :: exner_coarse
    type( field_type ) :: theta_coarse
    type( field_type ) :: mr_coarse(nummr)
    type( field_type ) :: mr_n_coarse(nummr)

    type( field_type ) :: exner_in_wth_coarse
    ! type( field_type ) :: delta_coarse
    type( field_type ) :: rho_in_wth_coarse
    type( field_type ) :: wetrho_in_wth_coarse
    type( field_type ) :: wetrho_in_w3_coarse
    type( field_type ) :: u_in_w3_coarse
    type( field_type ) :: v_in_w3_coarse
    type( field_type ) :: w_in_wth_coarse
    type( field_type ) :: theta_star_coarse
    type( field_type ) :: u_in_w3_star_coarse
    type( field_type ) :: v_in_w3_star_coarse

    type( field_type ) :: zh_coarse
    type( field_type ) :: zh_nonloc_coarse
    type( field_type ) :: zhsc_coarse
    type( field_type ) :: inv_depth_coarse
    type( integer_field_type ) :: bl_type_ind_coarse
    type( field_type ) :: tke_bl_coarse
    type( field_type ) :: wvar_coarse
    type( field_type ) :: rhokm_bl_coarse
    type( field_type ) :: moist_flux_coarse
    type( field_type ) :: heat_flux_coarse
    type( field_type ) :: taux_coarse
    type( field_type ) :: tauy_coarse

    type( field_type ) :: surf_interp_coarse
    type( field_type ) :: ustar_coarse

    type( field_type ) :: conv_rain_coarse
    type( field_type ) :: conv_rain_3d_coarse
    type( field_type ) :: conv_snow_coarse
    type( field_type ) :: conv_snow_3d_coarse
    type( field_type ) :: cca_2d_coarse
    type( field_type ) :: cv_base_coarse
    type( field_type ) :: cv_top_coarse
    type( field_type ) :: cca_coarse
    type( field_type ) :: ccw_coarse
    type( field_type ) :: dt_conv_coarse
    type( field_type ) :: dmv_conv_coarse
    type( field_type ) :: dmcl_conv_coarse
    type( field_type ) :: dms_conv_coarse
    type( field_type ) :: dcfl_conv_coarse
    type( field_type ) :: dcff_conv_coarse
    type( field_type ) :: dbcf_conv_coarse
    type( field_type ) :: du_conv_coarse
    type( field_type ) :: dv_conv_coarse
    type( field_type ) :: conv_prog_dtheta_coarse
    type( field_type ) :: conv_prog_dmv_coarse
    type( field_type ) :: dd_mf_cb_coarse
    type( field_type ) :: massflux_up_coarse
    type( field_type ) :: massflux_down_coarse
    type( field_type ) :: cape_diluted_coarse
    type( field_type ) :: pressure_inc_env_coarse

    type( field_type ) :: cf_fro_coarse
    type( field_type ) :: cf_liq_coarse
    type( field_type ) :: cf_bulk_coarse
    type( field_type ) :: cf_liq_n_coarse
    type( field_type ) :: cf_fro_n_coarse
    type( field_type ) :: cf_bulk_n_coarse

    type( field_type ) :: o3p_coarse
    type( field_type ) :: o1d_coarse
    type( field_type ) :: o3_coarse
    type( field_type ) :: n_coarse
    type( field_type ) :: no_coarse
    type( field_type ) :: no3_coarse
    type( field_type ) :: lumped_n_coarse
    type( field_type ) :: n2o5_coarse
    type( field_type ) :: ho2no2_coarse
    type( field_type ) :: hono2_coarse
    type( field_type ) :: h2o2_coarse
    type( field_type ) :: ch4_coarse
    type( field_type ) :: co_coarse
    type( field_type ) :: hcho_coarse
    type( field_type ) :: meoo_coarse
    type( field_type ) :: meooh_coarse
    type( field_type ) :: h_coarse
    type( field_type ) :: oh_coarse
    type( field_type ) :: ho2_coarse
    type( field_type ) :: cl_coarse
    type( field_type ) :: cl2o2_coarse
    type( field_type ) :: clo_coarse
    type( field_type ) :: oclo_coarse
    type( field_type ) :: br_coarse
    type( field_type ) :: lumped_br_coarse
    type( field_type ) :: brcl_coarse
    type( field_type ) :: brono2_coarse
    type( field_type ) :: n2o_coarse
    type( field_type ) :: lumped_cl_coarse
    type( field_type ) :: hocl_coarse
    type( field_type ) :: hbr_coarse
    type( field_type ) :: hobr_coarse
    type( field_type ) :: clono2_coarse
    type( field_type ) :: cfcl3_coarse
    type( field_type ) :: cf2cl2_coarse
    type( field_type ) :: mebr_coarse
    type( field_type ) :: hono_coarse
    type( field_type ) :: c2h6_coarse
    type( field_type ) :: etoo_coarse
    type( field_type ) :: etooh_coarse
    type( field_type ) :: mecho_coarse
    type( field_type ) :: meco3_coarse
