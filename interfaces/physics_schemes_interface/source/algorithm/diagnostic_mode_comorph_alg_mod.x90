                          cv_top_coarse,                                                                                &
                          pres_cv_base_coarse,                                                                          &
                          pres_cv_top_coarse,                                                                           &
                          pres_lowest_cv_base_coarse,                                                                   &
                          pres_lowest_cv_top_coarse,                                                                    &
                          lowest_cca_2d_coarse,                                                                         &
                          entrain_up_coarse,                                                                            &
                          entrain_down_coarse,                                                                          &
                          detrain_up_coarse,                                                                            &
                          detrain_down_coarse,                                                                          &
                          massflux_up_half_coarse)                                                                      &
                                               ) ! end of invoke
    
    call um_sizes_init(1_i_def)

    if ( subroutine_timers ) call timer("conv_comorph_alg")

    ! Call the diagnostics output routine
    if ( write_diag .and. use_xios_io ) then
      call log_event( 'Calling diagnostics output routine', LOG_LEVEL_INFO )
      call output_diags_for_diagnostic_mode_comorph(            &
                                  lowest_cv_base_coarse,        &
                                  lowest_cv_top_coarse,         &
                                  cv_base_coarse,               &
                                  cv_top_coarse,                &
                                  pres_cv_base_coarse,          &
                                  pres_cv_top_coarse,           &
                                  pres_lowest_cv_base_coarse,   &
                                  pres_lowest_cv_top_coarse,    &
                                  lowest_cca_2d_coarse,         &
                                  entrain_up_coarse,            & ! 3-D
                                  entrain_down_coarse,          &
                                  detrain_up_coarse,            &
                                  detrain_down_coarse,          &
                                  massflux_up_half_coarse)
    end if

  nullify( conv_mesh )

  end subroutine diagnostic_mode_comorph_alg

