    type( field_type ), pointer :: heat_flux => null()
    type( field_type ), pointer :: taux => null()
    type( field_type ), pointer :: tauy => null()

    type( field_type ), pointer :: surf_interp => null()
    type( field_type ), pointer :: ustar => null()

    type( field_type ), pointer :: conv_rain => null()
