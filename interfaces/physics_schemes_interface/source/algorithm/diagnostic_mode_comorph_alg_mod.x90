    call init_coarse_field_from(ls_snow_coarse, ls_snow, conv_mesh)

    ! Initialise local coarse fields
    ! TODO: This needs to be handled seperately because they don't
    ! have any corresponding coarse fields!
    ! Likely need to copy a modified version of comorph_diags_mod.x90
    !call initialise_diags_for_comorph(lowest_cv_base,       &
    !                                  lowest_cv_top,        &
    !                                  cv_base,              &
    !                                  cv_top,               &
    !                                  pres_cv_base,         &
    !                                  pres_cv_top,          &
    !                                  pres_lowest_cv_base,  &
    !                                  pres_lowest_cv_top,   &
    !                                  lowest_cca_2d,        &
    !                                  entrain_up,           & ! 3-D variables
    !                                  entrain_down,         &
    !                                  detrain_up,           &
    !                                  detrain_down,         &
    !                                  massflux_up_half)

    ! Map the fine fields to the coarse fields
    ! map_scalar_field works with generic W3/WTH scalar fields; nonconservative
    ! map_rho_intermesh is only for W3 space rho
    write(*,*) 'map_rho_intermesh on rho'
    call map_rho_intermesh(rho_coarse, rho)
    call map_scalar_field(exner_coarse, exner)
    call map_scalar_field(theta_coarse, theta)
    ! mr bundle fields
    call map_mr_bundle_intermesh(mr_coarse, mr, rho_coarse, rho)
    call map_mr_bundle_intermesh(mr_n_coarse, mr_n, rho_coarse, rho)
    ! Other derived fields
    call map_scalar_field(exner_in_wth_coarse, exner_in_wth)
    ! map_rho_intermesh only works with W3 fields, so use physics field
    ! mapping for wth equivalents of rho/wetrho
    write(*,*) 'map_rho_intermesh on wet_rho'
    call map_rho_intermesh(wetrho_in_w3_coarse, wetrho_in_w3)
    call log_event( 'map_physics_scalars for rho and wetrho', LOG_LEVEL_INFO )
    call map_physics_scalars(rho_in_wth_coarse, rho_coarse)
    call map_physics_scalars(wetrho_in_wth_coarse, wetrho_in_w3_coarse)
    ! u,v,w velocity components
    call map_scalar_field(u_in_w3_coarse, u_in_w3)
    call map_scalar_field(v_in_w3_coarse, v_in_w3)
    call map_scalar_field(w_in_wth_coarse, w_in_wth)
    call map_scalar_field(theta_star_coarse, theta_star)
    call map_scalar_field(u_in_w3_star_coarse, u_in_w3_star)
    call map_scalar_field(v_in_w3_star_coarse, v_in_w3_star)
    ! Boundary layer fields; these are 2D fields
    write(*,*) 'map_scalar_field on 2D BL fields'
    call map_scalar_field(zh_coarse, zh)
    call map_scalar_field(zh_nonloc_coarse, zh_nonloc)
    call map_scalar_field(zhsc_coarse, zhsc)
    call map_scalar_field(inv_depth_coarse, inv_depth)
    ! bl_type_ind is an integer field; TODO: use majority vote mapping
    ! For now we just set all indicators to zero since the kernel only
    ! cares whether or not it is a Type 7 BL; this is equivalent to saying
    ! that all of them are not Type 7 BL.
    write(*,*) 'setval_c on bl_type_ind'
    call invoke( int_setval_c(bl_type_ind_coarse, 0_i_def) )
    ! Boundary layer fields
    call map_scalar_field(tke_bl_coarse, tke_bl)
    call map_scalar_field(wvar_coarse, wvar)
    call map_scalar_field(rhokm_bl_coarse, rhokm_bl)
    call map_scalar_field(moist_flux_coarse, moist_flux)
    call map_scalar_field(heat_flux_coarse, heat_flux)
    call map_scalar_field(taux_coarse, taux)
    call map_scalar_field(tauy_coarse, tauy)
    ! Surface fields; does map_scalar_field work for 2D fields?
    call map_scalar_field(surf_interp_coarse, surf_interp)
    call map_scalar_field(ustar_coarse, ustar)
    ! Convection diagnostics
    call map_scalar_field(conv_rain_coarse, conv_rain)
    call map_scalar_field(conv_rain_3d_coarse, conv_rain_3d)
    call map_scalar_field(conv_snow_coarse, conv_snow)
    call map_scalar_field(conv_snow_3d_coarse, conv_snow_3d)
    call map_scalar_field(cca_2d_coarse, cca_2d)
    call map_scalar_field(cv_base_coarse, cv_base)
    call map_scalar_field(cv_top_coarse, cv_top)
    call map_scalar_field(cca_coarse, cca)
    call map_scalar_field(ccw_coarse, ccw)
    call map_scalar_field(dt_conv_coarse, dt_conv)
    call map_scalar_field(dmv_conv_coarse, dmv_conv)
    call map_scalar_field(dmcl_conv_coarse, dmcl_conv)
    call map_scalar_field(dms_conv_coarse, dms_conv)
    call map_scalar_field(dcfl_conv_coarse, dcfl_conv)
    call map_scalar_field(dcff_conv_coarse, dcff_conv)
    call map_scalar_field(dbcf_conv_coarse, dbcf_conv)
    call map_scalar_field(du_conv_coarse, du_conv)
    call map_scalar_field(dv_conv_coarse, dv_conv)
    call map_scalar_field(conv_prog_dtheta_coarse, conv_prog_dtheta)
    call map_scalar_field(conv_prog_dmv_coarse, conv_prog_dmv)
    call map_scalar_field(dd_mf_cb_coarse, dd_mf_cb)
    call map_scalar_field(massflux_up_coarse, massflux_up)
    call map_scalar_field(massflux_down_coarse, massflux_down)
    call map_scalar_field(cape_diluted_coarse, cape_diluted)
    call map_scalar_field(pressure_inc_env_coarse, pressure_inc_env)
    

    ! call the scheme
    !ncells = mesh%get_last_edge_cell()
    !call um_sizes_init(ncells)

    ! Placeholder invoke call needed for psyclone to parse and transform
    ! without falling over.
    ! call invoke( setval_c(exner_in_wth_coarse, 0.0_r_def) )

    !call invoke( conv_comorph_kernel_type( outer, rho, rho_in_wth,            &
    !                      wetrho_in_w3, wetrho_in_wth, exner, exner_in_wth,   &
    !                      delta, theta, u_in_w3, v_in_w3, w_in_wth,           &
    !                      theta_star, u_in_w3_star, v_in_w3_star,             &
    !                      height_w3, height_wth,                              &
    !                      dt_conv, dmv_conv, dmcl_conv,                       &
    !                      dms_conv, du_conv, dv_conv,                         &
    !                      conv_prog_dtheta, conv_prog_dmv,                    &
    !                      mr_n(imr_v), mr_n(imr_cl), mr_n(imr_ci),            &
    !                      mr_n(imr_r), mr_n(imr_g), mr_n(imr_s),              &
    !                      mr(imr_v), mr(imr_cl), mr(imr_ci),                  &
    !                      mr(imr_r), mr(imr_g), mr(imr_s),                    &
    !                      cf_fro, cf_liq, cf_bulk, cca, ccw, precfrac,        &
    !                      cf_liq_n, cf_fro_n, cf_bulk_n,                      &
    !                      cape_diluted, cca_2d,                               &
    !                      dd_mf_cb, massflux_up, massflux_down, tke_bl,       &
    !                      pressure_inc_env,                                   &
    !                      zh, zh_nonloc, inv_depth, zhsc, bl_type_ind,        &
    !                      wvar, rhokm_bl, moist_flux, heat_flux, taux, tauy,  &
    !                      surf_interp, ustar, ls_rain, ls_snow,               &
    !                      dcfl_conv, dcff_conv, dbcf_conv,                    &
    !                      o3p,                                                &
    !                      o1d,                                                &
    !                      o3,                                                 &
    !                      n,                                                  &
    !                      no,                                                 &
    !                      no3,                                                &
    !                      lumped_n,                                           &
    !                      n2o5,                                               &
    !                      ho2no2,                                             &
    !                      hono2,                                              &
    !                      h2o2,                                               &
    !                      ch4,                                                &
    !                      co,                                                 &
    !                      hcho,                                               &
    !                      meoo,                                               &
    !                      meooh,                                              &
    !                      h,                                                  &
    !                      oh,                                                 &
    !                      ho2,                                                &
    !                      cl,                                                 &
    !                      cl2o2,                                              &
    !                      clo,                                                &
    !                      oclo,                                               &
    !                      br,                                                 &
    !                      lumped_br,                                          &
    !                      brcl,                                               &
    !                      brono2,                                             &
    !                      n2o,                                                &
    !                      lumped_cl,                                          &
    !                      hocl,                                               &
    !                      hbr,                                                &
    !                      hobr,                                               &
    !                      clono2,                                             &
    !                      cfcl3,                                              &
    !                      cf2cl2,                                             &
    !                      mebr,                                               &
    !                      hono,                                               &
    !                      c2h6,                                               &
    !                      etoo,                                               &
    !                      etooh,                                              &
    !                      mecho,                                              &
    !                      meco3,                                              &
    !                      pan,                                                &
    !                      c3h8,                                               &
    !                      n_proo,                                             &
    !                      i_proo,                                             &
    !                      n_prooh,                                            &
    !                      i_prooh,                                            &
    !                      etcho,                                              &
    !                      etco3,                                              &
    !                      me2co,                                              &
    !                      mecoch2oo,                                          &
    !                      mecoch2ooh,                                         &
    !                      ppan,                                               &
    !                      meono2,                                             &
    !                      c5h8,                                               &
    !                      iso2,                                               &
    !                      isooh,                                              &
    !                      ison,                                               &
    !                      macr,                                               &
    !                      macro2,                                             &
    !                      macrooh,                                            &
    !                      mpan,                                               &
    !                      hacet,                                              &
    !                      mgly,                                               &
    !                      nald,                                               &
    !                      hcooh,                                              &
    !                      meco3h,                                             &
    !                      meco2h,                                             &
    !                      h2,                                                 &
    !                      meoh,                                               &
    !                      msa,                                                &
    !                      nh3,                                                &
    !                      cs2,                                                &
    !                      csul,                                               &
    !                      h2s,                                                &
    !                      so3,                                                &
    !                      passive_o3,                                         &
    !                      age_of_air,                                         &
    !                      dms,                                                &
    !                      so2,                                                &
    !                      h2so4,                                              &
    !                      dmso,                                               &
    !                      monoterpene,                                        &
    !                      secondary_organic,                                  &
    !                      n_nuc_sol,                                          &
    !                      nuc_sol_su,                                         &
    !                      nuc_sol_om,                                         &
    !                      n_ait_sol,                                          &
    !                      ait_sol_su,                                         &
    !                      ait_sol_bc,                                         &
    !                      ait_sol_om,                                         &
    !                      n_acc_sol,                                          &
    !                      acc_sol_su,                                         &
    !                      acc_sol_bc,                                         &
    !                      acc_sol_om,                                         &
    !                      acc_sol_ss,                                         &
    !                      n_cor_sol,                                          &
    !                      cor_sol_su,                                         &
    !                      cor_sol_bc,                                         &
    !                      cor_sol_om,                                         &
    !                      cor_sol_ss,                                         &
    !                      n_ait_ins,                                          &
    !                      ait_ins_bc,                                         &
    !                      ait_ins_om,                                         &
    !                      n_acc_ins,                                          &
    !                      acc_ins_du,                                         &
    !                      n_cor_ins,                                          &
    !                      cor_ins_du,                                         &
    !                      tnuc,                                               &
    !                      lowest_cv_base,                                     &
    !                      lowest_cv_top,                                      &
    !                      cv_base,                                            &
    !                      cv_top,                                             &
    !                      pres_cv_base,                                       &
    !                      pres_cv_top,                                        &
    !                      pres_lowest_cv_base,                                &
    !                      pres_lowest_cv_top,                                 &
    !                      lowest_cca_2d,                                      &
    !                      entrain_up,                                         &   ! 3-D local variables
    !                      entrain_down,                                       &
    !                      detrain_up,                                         &
    !                      detrain_down,                                       &
    !                      massflux_up_half)                                   &
    !                                           ) ! end of invoke

    !call um_sizes_init(1_i_def)

    !if ( subroutine_timers ) call timer("conv_comorph_alg")

    ! output diagnostics on last iteration only
    !if (write_diag .and. use_xios_io .and. outer == outer_iterations) then

    !  call output_diags_for_comorph( cca,                & ! prognostics
    !                              ccw,                   &
    !                              dt_conv,               & ! increments
    !                              dmv_conv,              &
    !                              dmcl_conv,             &
    !                              dms_conv,              &
    !                              du_conv,               &
    !                              dv_conv,               &
    !                              dbcf_conv,             &
    !                              dcfl_conv,             &
    !                              dcff_conv,             &
    !                              massflux_up,           & ! not local
    !                              massflux_down,         &
    !                              cape_diluted,          &
    !                              conv_rain,             &
    !                              conv_snow,             &
    !                              conv_rain_3d,          &
    !                              conv_snow_3d,          &
    !                              cca_2d,                &
    !                              lowest_cv_base,        &
    !                              lowest_cv_top,         &
    !                              cv_base,               &
    !                              cv_top,                &
    !                              pres_cv_base,          &
    !                              pres_cv_top,           &
    !                              pres_lowest_cv_base,   &
    !                              pres_lowest_cv_top,    &
    !                              lowest_cca_2d,         &
    !                              entrain_up,            & ! 3-D
    !                              entrain_down,          &
    !                              detrain_up,            &
    !                              detrain_down,          &
    !                              massflux_up_half)
    !end if

    nullify( conv_mesh )

  end subroutine diagnostic_mode_comorph_alg

  !> @brief Initialise a coarse field from a given reference fine field.
  !> @post  The field name will be set equal to the XIOS id passed in.
  !> @param[inout]        field            Field to initialise
  !> @param[in]           ref_field        Reference field
  !> @param[in]           conv_mesh        mesh name of the coarse convection grid
  !> @param[in, optional] xios_id          XIOS id of field
  subroutine init_coarse_field_from(field, ref_field, conv_mesh, xios_id)

    use function_space_collection_mod, only: function_space_collection
    use function_space_mod,            only: function_space_type

    implicit none

    type(field_type),      intent(inout) :: field
    type(field_type),         intent(in) :: ref_field
    type(mesh_type), pointer, intent(in) :: conv_mesh
    character(*), optional,   intent(in) :: xios_id

    ! Local variables
    integer(kind=i_def)                :: fs
    type(function_space_type), pointer :: vs_conv => null()
    
    ! Retrieve the function space type
    fs = ref_field%which_function_space()
    ! Create the convection grid vector space
    vs_conv => function_space_collection%get_fs( conv_mesh, 0, 0, fs )
    ! Initialise the coarse convection grid field
    if ( present(xios_id) ) then 
      ! Assign the corresponding xios id
      call field%initialise(vector_space = vs_conv, name=xios_id)
    else
      call field%initialise(vector_space = vs_conv)
    end if

  end subroutine init_coarse_field_from

  !> @brief Initialise a integer_field type coarse field from a given reference fine field.
  !> @post  The field name will be set equal to the XIOS id passed in.
  !> @param[inout]        field            Field to initialise
  !> @param[in]           ref_field        Reference field
  !> @param[in]           conv_mesh        mesh name of the coarse convection grid
  !> @param[in, optional] xios_id          XIOS id of field
  subroutine init_coarse_integer_field_from(int_field, ref_int_field, conv_mesh, xios_id)

    use function_space_collection_mod, only: function_space_collection
    use function_space_mod,            only: function_space_type

    implicit none

    type(integer_field_type),      intent(inout) :: int_field
    type(integer_field_type),         intent(in) :: ref_int_field
    type(mesh_type), pointer, intent(in) :: conv_mesh
    character(*), optional,   intent(in) :: xios_id

    ! Local variables
    integer(kind=i_def)                :: fs
    type(function_space_type), pointer :: vs_conv => null()
    
    ! Retrieve the function space type
    fs = ref_int_field%which_function_space()
    ! Create the convection grid vector space
    vs_conv => function_space_collection%get_fs( conv_mesh, 0, 0, fs )
    ! Initialise the coarse convection grid field
    if ( present(xios_id) ) then 
      ! Assign the corresponding xios id
      call int_field%initialise(vector_space = vs_conv, name=xios_id)
    else
      call int_field%initialise(vector_space = vs_conv)
    end if

  end subroutine init_coarse_integer_field_from

end module diagnostic_mode_comorph_alg_mod
