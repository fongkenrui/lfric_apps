    type( field_type ), pointer :: hono => null()
    type( field_type ), pointer :: c2h6 => null()
    type( field_type ), pointer :: etoo => null()
    type( field_type ), pointer :: etooh => null()
    type( field_type ), pointer :: mecho => null()
