    call map_scalar_field(nuc_sol_su_coarse, nuc_sol_su)
    call map_scalar_field(nuc_sol_om_coarse, nuc_sol_om)
    call map_scalar_field(n_ait_sol_coarse, n_ait_sol)
    call map_scalar_field(ait_sol_su_coarse, ait_sol_su)
    call map_scalar_field(ait_sol_bc_coarse, ait_sol_bc)
    call map_scalar_field(ait_sol_om_coarse, ait_sol_om)
