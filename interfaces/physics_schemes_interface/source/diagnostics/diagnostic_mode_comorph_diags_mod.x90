!> @brief Diagnostic module for diagnostic-mode comorph

module diagnostic_mode_comorph_diags_mod

  use constants_mod,       only: l_def
  use field_mod,           only: field_type
  use integer_field_mod,    only: integer_field_type
  use field_collection_mod, only: field_collection_type
  use log_mod,              only: log_event, log_scratch_space, &
                                  LOG_LEVEL_DEBUG, LOG_LEVEL_INFO, LOG_LEVEL_ERROR
  use mesh_mod,             only: mesh_type
  use mesh_collection_mod,  only: mesh_collection
  use mr_indices_mod,       only: nummr, imr_v, imr_cl, imr_ci, imr_r, imr_g,&
       imr_s
  use fs_continuity_mod,           only: W3, Wtheta
  use extrusion_mod,               only: TWOD
  use io_config_mod,       only: subroutine_timers
  use timer_mod,           only: timer
  use function_space_collection_mod, only: function_space_collection
  use function_space_mod,            only: function_space_type
  use initialise_diagnostics_mod,     only : init_diag &
                                             => init_diagnostic_field

  implicit none

  private

  ! Module-level logicals indicating whether diagnostics are requested
  ! This isn't actually being used currently because the diagnostics are
  ! initialised with hardcoded function space definitions...
  logical( l_def ) :: lowest_cv_base_flag,         &
                      lowest_cv_top_flag,          &
                      pres_cv_base_flag,           &
                      pres_cv_top_flag,            &
                      pres_lowest_cv_base_flag,    &
                      pres_lowest_cv_top_flag,     &
                      lowest_cca_2d_flag,          &
                      entrain_up_flag,             & ! 3-D
                      entrain_down_flag,           &
                      detrain_up_flag,             &
                      detrain_down_flag,           &
                      massflux_up_half_flag

  ! At some point maybe want to add interfaces to overload the
  ! init subroutines similar to init_field_fro_metadata in field_from_metadata_mod.  
  public :: init_coarse_field_from
  public :: init_coarse_integer_field_from
  public :: init_coarse_field
  public :: init_coarse_integer_field
  public :: initialise_diags_for_diagnostic_mode_comorph
  public :: output_diags_for_diagnostic_mode_comorph

contains

  !> @brief Initialise a coarse field from a given reference fine field.
  !> @post  The field name will be set equal to the XIOS id passed in.
  !> @param[inout]        field            Field to initialise
  !> @param[in]           ref_field        Reference field
  !> @param[in]           conv_mesh        mesh name of the coarse convection grid
  !> @param[in, optional] xios_id          XIOS id of field
  subroutine init_coarse_field_from(field, ref_field, conv_mesh, xios_id)

    implicit none

    type(field_type),      intent(inout) :: field
    type(field_type),         intent(in) :: ref_field
    type(mesh_type), pointer, intent(in) :: conv_mesh
    character(*), optional,   intent(in) :: xios_id

    ! Local variables
    integer                            :: fs
    integer                            :: element_order_h
    integer                            :: element_order_v
    integer                            :: ref_extrusion_id
    type(mesh_type), pointer           :: ref_mesh => null()
    type(mesh_type), pointer           :: target_mesh => null()
    type(function_space_type), pointer :: vs_conv => null()
    
    ! Retrieve the function space type
    fs = ref_field%which_function_space()

    ! Should be lowest order, but this is for safety 
    element_order_h = ref_field%get_element_order_h()
    element_order_v = ref_field%get_element_order_v()

    ! Need to be able to handle 2D fields correctly; otherwise will try to
    ! map 2D fine fields to 3D coarse fields and fail.
    ref_mesh => ref_field%get_mesh()
    ref_extrusion_id = ref_mesh%get_extrusion_id()

    if ( ref_extrusion_id == conv_mesh%get_extrusion_id() ) then
      target_mesh => conv_mesh
    else
      target_mesh => mesh_collection%get_mesh(conv_mesh, ref_extrusion_id)
    end if

    ! Raise an error if no equivalent extrusion for the conv_mesh
    ! This can occur if multires_coupling_mesh_tags is not set properly
    if ( .not. associated(target_mesh) ) then
      call log_event('No equivalent extrusion for conv_mesh found', LOG_LEVEL_ERROR)
    end if

    ! Create the convection grid vector space
    vs_conv => function_space_collection%get_fs( target_mesh,      &
                                                 element_order_h,  &
                                                 element_order_v,  &
                                                 fs )
    ! Initialise the coarse convection grid field
    if ( present(xios_id) ) then 
      ! Assign the corresponding xios id
      call field%initialise(vector_space = vs_conv, name=xios_id)
    else
      call field%initialise(vector_space = vs_conv)
    end if

  end subroutine init_coarse_field_from

  !> @brief Initialise a integer_field type coarse field from a given reference fine field.
  !> @post  The field name will be set equal to the XIOS id passed in.
  !> @param[inout]        field            Field to initialise
  !> @param[in]           ref_field        Reference field
  !> @param[in]           conv_mesh        mesh name of the coarse convection grid
  !> @param[in, optional] xios_id          XIOS id of field
  subroutine init_coarse_integer_field_from(int_field, ref_int_field, conv_mesh, xios_id)

    implicit none

    type(integer_field_type),      intent(inout) :: int_field
    type(integer_field_type),         intent(in) :: ref_int_field
    type(mesh_type), pointer, intent(in) :: conv_mesh
    character(*), optional,   intent(in) :: xios_id

    ! Local variables
    integer                            :: fs
    integer                            :: ref_extrusion_id
    type(mesh_type), pointer           :: ref_mesh => null()
    type(mesh_type), pointer           :: target_mesh => null()
    type(function_space_type), pointer :: vs_conv => null()
    
    ! Retrieve the function space type
    fs = ref_int_field%which_function_space()
    ! Note: Integer fields are discontinuous spaces so no element orders

    ! Need to be able to handle 2D fields correctly; otherwise will try to
    ! map 2D fine fields to 3D coarse fields and fail.
    ref_mesh => ref_int_field%get_mesh()
    ref_extrusion_id = ref_mesh%get_extrusion_id()

    if ( ref_extrusion_id == conv_mesh%get_extrusion_id() ) then
      target_mesh => conv_mesh
    else
      target_mesh => mesh_collection%get_mesh(conv_mesh, ref_extrusion_id)
    end if
    
    ! Raise an error if no equivalent extrusion for the conv_mesh
    ! This can occur if multires_coupling_mesh_tags is not set properly
    if ( .not. associated(target_mesh) ) then
      call log_event('No equivalent extrusion for conv_mesh found', LOG_LEVEL_ERROR)
    end if

    ! Create the convection grid vector space
    vs_conv => function_space_collection%get_fs( target_mesh, 0, 0, fs )
    ! Initialise the coarse convection grid field
    if ( present(xios_id) ) then 
      ! Assign the corresponding xios id
      call int_field%initialise(vector_space = vs_conv, name=xios_id)
    else
      call int_field%initialise(vector_space = vs_conv)
    end if

  end subroutine init_coarse_integer_field_from

  !> @brief Initialise a custom coarse field.
  !> @post  The field name will be set equal to the XIOS id passed in.
  !> @param[inout]        field            Field to initialise
  !> @param[in]           conv_mesh        mesh name of the coarse convection grid
  !> @param[in]           fs_type          Function space type of the field to be initialised
  !> @param[in, optional] extrusion_id     Extrusion id of the field to be initialised (if TWOD)
  !> @param[in, optional] xios_id          XIOS id of field
  subroutine init_coarse_field(field, conv_mesh, fs_type, extrusion_id, xios_id)

    implicit none

    type(field_type),      intent(inout) :: field
    type(mesh_type), pointer, intent(in) :: conv_mesh
    ! Specify whether it is W3 or WTHETA
    integer,                  intent(in) :: fs_type
    ! Optionally specify whether it is a TWOD mesh
    integer, optional,        intent(in) :: extrusion_id
    ! Optionally provide the xios id, but by default leave this unset
    ! and only specify during write_field() call in diagnostic output
    character(*), optional,   intent(in) :: xios_id

    type(mesh_type), pointer           :: target_mesh => null()
    type(function_space_type), pointer :: vs_conv => null()

    ! Check whether asking for 2D field
    if ( present(extrusion_id) ) then
      target_mesh => mesh_collection%get_mesh_variant(conv_mesh, &
                                                      extrusion_id=extrusion_id)
    else
      target_mesh => conv_mesh
    end if

    ! Raise an error if no equivalent extrusion for the conv_mesh
    ! This can occur if multires_coupling_mesh_tags is not set properly
    if ( .not. associated(target_mesh) ) then
      call log_event('No equivalent extrusion for conv_mesh found', LOG_LEVEL_ERROR)
    end if

    ! Create the convection grid vector space on the target mesh
    vs_conv => function_space_collection%get_fs( target_mesh, 0, 0, fs_type )
    
    ! Initialise the coarse convection grid field
    if ( present(xios_id) ) then 
      ! Assign the corresponding xios id
      call field%initialise(vector_space = vs_conv, name=xios_id)
    else
      call field%initialise(vector_space = vs_conv)
    end if

  end subroutine init_coarse_field

  !> @brief Initialise a custom coarse field.
  !> @post  The field name will be set equal to the XIOS id passed in.
  !> @param[inout]        integer_field    Integer field to initialise
  !> @param[in]           conv_mesh        mesh name of the coarse convection grid
  !> @param[in]           fs_type          Function space type of the field to be initialised
  !> @param[in, optional] extrusion_id     Extrusion id of the field to be initialised (if TWOD)
  !> @param[in, optional] xios_id          XIOS id of field
  subroutine init_coarse_integer_field(int_field, conv_mesh, fs_type, extrusion_id, xios_id)

    implicit none

    type(integer_field_type), intent(inout) :: int_field
    type(mesh_type), pointer,    intent(in) :: conv_mesh
    ! Specify whether it is W3 or WTHETA
    integer,                  intent(in) :: fs_type
    ! Optionally specify whether it is a TWOD mesh
    integer, optional,        intent(in) :: extrusion_id
    ! Optionally provide the xios id, but by default leave this unset
    ! and only specify during write_field() call in diagnostic output
    character(*), optional,   intent(in) :: xios_id

    type(mesh_type), pointer           :: target_mesh => null()
    type(function_space_type), pointer :: vs_conv => null()

    ! Check whether asking for 2D field
    if ( present(extrusion_id) ) then
      target_mesh => mesh_collection%get_mesh_variant(conv_mesh, &
                                                      extrusion_id=extrusion_id)
    else
      target_mesh => conv_mesh
    end if

    ! Raise an error if no equivalent extrusion for the conv_mesh
    ! This can occur if multires_coupling_mesh_tags is not set properly
    if ( .not. associated(target_mesh) ) then
      call log_event('No equivalent extrusion for conv_mesh found', LOG_LEVEL_ERROR)
    end if

    ! Create the convection grid vector space on the target mesh
    vs_conv => function_space_collection%get_fs( target_mesh, 0, 0, fs_type )
    
    ! Initialise the coarse convection grid field
    if ( present(xios_id) ) then 
      ! Assign the corresponding xios id
      call int_field%initialise(vector_space = vs_conv, name=xios_id)
    else
      call int_field%initialise(vector_space = vs_conv)
    end if

  end subroutine init_coarse_integer_field

  !> @brief Initialise fields for locally-computed diagnostics
  subroutine initialise_diags_for_diagnostic_mode_comorph(conv_mesh,                     &
                                                          lowest_cv_base_coarse,         &
                                                          lowest_cv_top_coarse,          &
                                                          pres_cv_base_coarse,           &
                                                          pres_cv_top_coarse,            &
                                                          pres_lowest_cv_base_coarse,    &
                                                          pres_lowest_cv_top_coarse,     &
                                                          lowest_cca_2d_coarse,          &
                                                          entrain_up_coarse,             & ! 3-D
                                                          entrain_down_coarse,           &
                                                          detrain_up_coarse,             &
                                                          detrain_down_coarse,           &
                                                          massflux_up_half_coarse)

    implicit none
    ! This is pretty much a copy of initialise_diags_for_comorph, but modified to pair
    ! with the specific coarse-field diagnostics as defined in xios metadata.

    type(mesh_type), pointer,    intent(in) :: conv_mesh

    ! Diagnostic fields to initialise
    type( field_type ), intent(inout) :: lowest_cv_base_coarse,          &
                                         lowest_cv_top_coarse,           &
                                         pres_cv_base_coarse,            &
                                         pres_cv_top_coarse,             &
                                         pres_lowest_cv_base_coarse,     &
                                         pres_lowest_cv_top_coarse,      &
                                         lowest_cca_2d_coarse,           &
                                         entrain_up_coarse,              & ! 3-D
                                         entrain_down_coarse,            &
                                         detrain_up_coarse,              &
                                         detrain_down_coarse,            &
                                         massflux_up_half_coarse

    if ( subroutine_timers ) call timer("diagnostic_mode_comorph_diags")

    ! Instead of initialising with init_diag from metadata, here the fields are
    ! hardcoded, to avoid having to modify the metadata parser. This isn't a good
    ! long-term solution however...

    ! conv_face (TWOD, WTHETA)
    ! While these are integer outputs in xios diagnostics, they are regular
    ! fields in the comorph kernel type definition...
    call init_coarse_field(lowest_cv_base_coarse, conv_mesh, WTHETA, TWOD)
    call init_coarse_field(lowest_cv_top_coarse, conv_mesh, WTHETA, TWOD)
    
    ! conv_face (TWOD, WTHETA) real
    call init_coarse_field(pres_cv_base_coarse, conv_mesh, WTHETA, TWOD)
    call init_coarse_field(pres_cv_top_coarse, conv_mesh, WTHETA, TWOD)
    call init_coarse_field(pres_lowest_cv_base_coarse, conv_mesh, WTHETA, TWOD)
    call init_coarse_field(pres_lowest_cv_top_coarse, conv_mesh, WTHETA, TWOD)
    call init_coarse_field(lowest_cca_2d_coarse, conv_mesh, WTHETA, TWOD)

    ! conv_full_level_face_grid (3D, WTHETA) real
    call init_coarse_field(entrain_up_coarse, conv_mesh, WTHETA)
    call init_coarse_field(entrain_down_coarse, conv_mesh, WTHETA)
    call init_coarse_field(detrain_up_coarse, conv_mesh, WTHETA)
    call init_coarse_field(detrain_down_coarse, conv_mesh, WTHETA)

    ! conv_half_level_face_grid (3D, W3) real
    call init_coarse_field(massflux_up_half_coarse, conv_mesh, W3)
    
    ! Initialise values to zero for fields passed to kernel 
    call invoke( setval_c(entrain_up_coarse, 0.0_r_def) )
    call invoke( setval_c(entrain_down_coarse, 0.0_r_def) )
    call invoke( setval_c(detrain_up_coarse, 0.0_r_def) )
    call invoke( setval_c(detrain_down_coarse, 0.0_r_def) )

    if ( subroutine_timers ) call timer("diagnostic_mode_comorph_diags")

  end subroutine initialise_diags_for_diagnostic_mode_comorph

  !> @brief Output diagnostics from comorph_alg
  subroutine output_diags_for_diagnostic_mode_comorph( lowest_cv_base_coarse,        &
                                                       lowest_cv_top_coarse,         &
                                                       cv_base_coarse,               &
                                                       cv_top_coarse,                &
                                                       pres_cv_base_coarse,          &
                                                       pres_cv_top_coarse,           &
                                                       pres_lowest_cv_base_coarse,   &
                                                       pres_lowest_cv_top_coarse,    &
                                                       lowest_cca_2d_coarse,         &
                                                       entrain_up_coarse,            & 
                                                       entrain_down_coarse,          &
                                                       detrain_up_coarse,            &
                                                       detrain_down_coarse,          &
                                                       massflux_up_half_coarse)

    implicit none

    ! Local diagnostic fields to output
    type( field_type ), intent(in) :: lowest_cv_base_coarse,          &
                                      lowest_cv_top_coarse,           &
                                      cv_base_coarse,                 &
                                      cv_top_coarse,                  &
                                      pres_cv_base_coarse,            &
                                      pres_cv_top_coarse,             &
                                      pres_lowest_cv_base_coarse,     &
                                      pres_lowest_cv_top_coarse,      &
                                      lowest_cca_2d_coarse,           &
                                      entrain_up_coarse,              & 
                                      entrain_down_coarse,            &
                                      detrain_up_coarse,              &
                                      detrain_down_coarse,            &
                                      massflux_up_half_coarse

    if ( subroutine_timers ) call timer("diagnostic_mode_comorph_diags")
    ! Write the fields here
    
    call lowest_cv_base_coarse%write_field()
    call lowest_cv_top_coarse%write_field()
    call cv_base_coarse%write_field()
    call cv_top_coarse%write_field()
    call pres_cv_base_coarse%write_field()
    call pres_cv_top_coarse%write_field()
    call pres_lowest_cv_base_coarse%write_field()
    call pres_lowest_cv_top_coarse%write_field()
    call lowest_cca_2d_coarse%write_field()

    ! 3D
    call entrain_up_coarse%write_field()
    call entrain_down_coarse%write_field()
    call detrain_up_coarse%write_field()
    call detrain_down_coarse%write_field()
    call massflux_up_half_coarse%write_field()
    if ( subroutine_timers ) call timer("diagnostic_mode_comorph_diags")

  end subroutine output_diags_for_diagnostic_mode_comorph 
  
end module diagnostic_mode_comorph_diags_mod
