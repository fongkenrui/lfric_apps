!-------------------------------------------------------------------------------
!> @brief Local newtonian relaxation of model prognostics
!> @details This is intended for use in idealised model simulations in a
!>          Cartesian domain to damp out the model prognostics near the top
!>          boundary. Newtonian relaxation is applied in a local
!>          manner to the model prognostics \phi = {\theta, u, v, q} with
!>          \f[
!>             \frac{\partial\phi}{\partial t}(t,x,y,z) =
!>             -\frac{\phi(t,x,y,z)-\phi_{\mathrm target}(t,z)}
!>                   {\tau},
!>          \f]
!>          where \f$\phi_{\mathrm target}(t,z)\f$ is the target profile,
!>          which may be time-varying, and \f$\tau\f$ is the timescale for
!>          the relaxation.
module newton_damping_layer_alg_mod

  use constants_mod,                 only: i_def, r_def, l_def
  use field_mod,                     only: field_type
  use fs_continuity_mod,             only: Wtheta, W3
  use function_space_collection_mod, only: function_space_collection
  use sci_geometric_constants_mod,   only: get_height_fv
  use mesh_mod,                      only: mesh_type
  use planet_config_mod,             only: kappa, p_zero
  use timestepping_config_mod,       only: dt
  !> @todo Data passed to the kernel via module 'use' statements.
  !>       When PSyclone supports passing of arrays into kernels (issue #1312),
  !>       these data should be passed through the argument list of the invoke.
  use profile_interp_kernel_mod,     only: profile_interp_kernel_type, &
                                           profile_size,               &
                                           profile_data,               &
                                           profile_heights
  use prof_temporal_interp_mod,      only: prof_temporal_interp

  implicit none

  private
  public :: newton_damping_layer_alg

contains

  !> @brief Algorithm to calculate Newtonian relaxation of potential temperature
  !> @param[in,out] dtheta_forcing Relaxation increment
  !> @param[in]     theta Dry potential temperature
  !> @param[in]     exner_in_wth Exner mapped to Wtheta space
  !> @param[in]     twod_mesh Information  about the horizontal mesh
  !> @param[in]     time_now Current model time in seconds
  !> @param[in]     nlayers Number of layers in the grid
  subroutine theta_relax_alg( dtheta_forcing, du_forcing, theta, u, exner_in_wth,   &
                              twod_mesh, time_now, nlayers )
  
  !TODO: Edit the rose-meta config definition
  use newton_damping_layer_config_mod, only: number_times,                     &
                                    number_heights,                            &
                                    times,                                     &
                                    heights,                                   &
                                    coordinate,                                &
                                    coordinate_pressure,                       &
                                    theta_relax_data => theta_profile_data,    &
                                    u_relax_data => u_profile_data,            &
                                    v_relax_data => v_profile_data,            &
                                    w_relax_data => w_profile_data,            &
                                    newton_dl_base,                            &
                                    newton_dl_scale_height,                    &
                                    timescale

  implicit none
  
  ! Slow physics model increments to modify.
  type( field_type ), intent(inout)       :: dtheta_forcing
  type( field_type ), intent(inout)       :: du_forcing

  ! Model prognostic fields for damping.
  type( field_type ), intent(in), target  :: theta
  type( field_type ), intent(in), target  :: u
  type( field_type ), intent(in), target  :: exner_in_wth
  type( mesh_type ),  intent(in), pointer :: twod_mesh

  real( kind=r_def ),    intent(in) :: time_now
  integer( kind=i_def ), intent(in) :: nlayers

  real( kind=r_def )          :: dt_rdef

  ! Interpolated relaxation profiles
  real( kind=r_def )          :: theta_relax_now(number_heights)
  real( kind=r_def )          :: u_wind_relax_now(number_heights)
  real( kind=r_def )          :: v_wind_relax_now(number_heights)

  ! Physics fields to unpack W2 function space winds into.
  ! Horizontal winds may need to be assigned as relaxation targets
  type( field_type ), target  :: u_in_w3 
  type( field_type ), target  :: v_in_w3 
  type( field_type ), target  :: w_in_w3 

  real( kind=r_def )          :: relaxation_coeff
  integer( kind=i_def )       :: k, mesh_id
  logical( kind=l_def )       :: profile_extrap
  
  ! Relaxation increments
  type( field_type )          :: dtheta_relax
  ! w2 field for relaxation increments
  type( field_type )          :: du_relaxation_forcing
  ! Physics fields for relaxation components
  type( field_type )          :: du_relax
  type( field_type )          :: dv_relax
  type( field_type )          :: dw_relax

  type( field_type ), pointer :: height_wth => null()
  type( mesh_type ),  pointer :: u_mesh

  ! Only apply relaxation between the specified times, unless only
  ! one time is specified. In the later case relaxation applies at all times.
  if ( number_times > 1 .and. &
       ( time_now < times(1) .or. time_now > times(number_times) ) ) return

  dt_rdef = real( dt, kind=r_def )

  ! TODO: Scale the relaxation coefficient with an exponential profile starting
  ! from newton_dl_base and ending at the model top.
  relaxation_coeff = dt_rdef / timescale
  
  ! Get mesh information needed for W2 function space
  u_mesh => du_forcing%get_mesh()
  
  ! Initialise the temporary fields needed
  call dtheta_relax%initialise( vector_space = theta%get_function_space() )

  call du_relaxation_forcing%initialise( vector_space = u%get_function_space() )

  call u_in_w3%initialise( vector_space = &
                function_space_collection%get_fs( u_mesh, 0, 0, W3 ) )

  call v_in_w3%initialise( vector_space = &
                function_space_collection%get_fs( u_mesh, 0, 0, W3 ) )

  call w_in_w3%initialise( vector_space = &
                function_space_collection%get_fs( u_mesh, 0, 0, W3 ) )

  call du_relax%initialise( vector_space = u_in_w3%get_function_space() )

  call dv_relax%initialise( vector_space = v_in_w3%get_function_space() )

  call dw_relax%initialise( vector_space = w_in_w3%get_function_space() )

  ! Map the actual w2 wind field to physics components
  call map_physics_winds( u_in_w3, v_in_w3, w_in_w3, u )

  if ( number_times == 1 ) then
    ! This is what applies for a time-constant relaxation profile
    theta_relax_now(:) = theta_relax_data(:)
    u_relax_now(:) = u_relax_data(:)
    v_relax_now(:) = v_relax_data(:)
    w_relax_now(:) = w_relax_data(:)
  else
    ! Interpolate the relaxation time series to current time
    call prof_temporal_interp( time_now, number_heights, number_times, times, &
                               theta_relax_data, theta_relax_now )
    call prof_temporal_interp( time_now, number_heights, number_times, times, &
                               u_relax_data, u_relax_now )
    call prof_temporal_interp( time_now, number_heights, number_times, times, &
                               v_relax_data, v_relax_now )
    call prof_temporal_interp( time_now, number_heights, number_times, times, &
                               w_relax_data, w_relax_now )
  end if


  if ( number_heights == 1 ) then
    ! Constant relaxation with height
    ! Calculate the relaxation increments
    call invoke( setval_c( dtheta_relax, theta_relax_now(1) ),     &
                 inc_X_minus_Y( dtheta_relax, theta ),             &
                 inc_a_times_X( relaxation_coeff, dtheta_relax ),  &
                 inc_X_plus_Y( dtheta_forcing, dtheta_relax ) )
    call invoke( setval_c( du_relax, u_relax_now(1) ),        &
                 inc_X_minus_Y( du_relax, u_in_w3 ),               &
                 inc_a_times_X( relaxation_coeff, du_relax ) )
    call invoke( setval_c( dv_relax, v_relax_now(1) ),        &
                 inc_X_minus_Y( dv_relax, v_in_w3 ),               &
                 inc_a_times_X( relaxation_coeff, dv_relax ) )
    call invoke( setval_c( dw_relax, w_relax_now(1) ),        &
                 inc_X_minus_Y( dw_relax, w_in_w3 ),               &
                 inc_a_times_X( relaxation_coeff, dw_relax ) )

  else
    ! Specified relaxation profile with height
    profile_size = number_heights

    ! Copy over the reference heights
    profile_heights( 1:profile_size ) = heights( 1:profile_size )
    if ( coordinate == coordinate_pressure ) then
      ! If the target profile is specified with pressure as the vertical
      ! coordinate then use Exner as the interpolation coordinate. This
      ! avoids having to create the p_in_wth field for use as vertical
      ! coordinate of the model data.
      do k = 1, number_heights
        profile_heights(k) = (profile_heights(k) / p_zero) ** kappa
      end do
      height_wth => exner_in_wth
    else
      mesh_id = dtheta_relax%get_mesh_id()
      height_wth => get_height_fv( Wtheta, mesh_id )
    end if

    ! Copy over theta_relax profile to module global profile_data for interpolation kernel
    profile_data( 1:profile_size ) = theta_relax_now( 1:profile_size )
    profile_extrap = .false.
    call invoke( setval_X( dtheta_relax, theta),                  &
                 profile_interp_kernel_type( dtheta_relax, height_wth, &
                                             profile_extrap ),         &
                 inc_X_minus_Y( dtheta_relax, theta ),            &
                 inc_a_times_X( relaxation_coeff, dtheta_relax ),      &
                 inc_X_plus_Y( dtheta_forcing, dtheta_relax ) )

    ! Repeat for u-wind
    profile_data( 1:profile_size ) = u_relax_now( 1:profile_size )
    profile_extrap = .false.
    call invoke( setval_X( du_relax, u_relax_target),                  &
                 ! Write interpolated profile to du_relax
                 profile_interp_kernel_type( du_relax, height_wth, &
                                             profile_extrap ),         &
                 ! Find the difference; this is zero for levels outside of profile range
                 inc_X_minus_Y( du_relax, u_relax_target ),            &
                 inc_a_times_X( relaxation_coeff, du_relax ) )
    
    ! Now repeat for v-wind
    profile_data( 1:profile_size ) = v_relax_now( 1:profile_size )
    profile_extrap = .false.
    call invoke( setval_X( dv_relax, v_relax_target),                  &
                 profile_interp_kernel_type( dv_relax, height_wth, &
                                             profile_extrap ),         &
                 inc_X_minus_Y( dv_relax, v_relax_target ),            &
                 inc_a_times_X( relaxation_coeff, dv_relax ) )

    ! Transform the relaxation increments back to w2 space
    call set_wind( du_relaxation_forcing, du_relax, dv_relax, dw_relax)
    ! Add relaxation increments to forcing
    call invoke( inc_X_plus_Y( du_forcing, du_relaxation_forcing ) ) 

  end if

  end subroutine newton_damping_layer_alg
end module newton_damping_layer_alg_mod
