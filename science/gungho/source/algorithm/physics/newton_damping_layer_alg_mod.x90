!-------------------------------------------------------------------------------
!> @brief Local newtonian relaxation of model prognostics
!> @details This is intended for use in idealised model simulations in a
!>          Cartesian domain to damp out the model prognostics near the top
!>          boundary. Newtonian relaxation is applied in a local
!>          manner to the model prognostics \phi = {\theta, u, v, q} with
!>          \f[
!>             \frac{\partial\phi}{\partial t}(t,x,y,z) =
!>             -\frac{\phi(t,x,y,z)-\phi_{\mathrm target}(t,z)}
!>                   {\tau},
!>          \f]
!>          where \f$\phi_{\mathrm target}(t,z)\f$ is the target profile,
!>          which may be time-varying, and \f$\tau\f$ is the timescale for
!>          the relaxation.
module newton_damping_layer_alg_mod

  use constants_mod,                 only: i_def, r_def, l_def
  use log_mod,                       only: log_event, LOG_LEVEL_INFO, LOG_LEVEL_ERROR
  use field_mod,                     only: field_type
  use fs_continuity_mod,             only: Wtheta, W3, W2H
  use function_space_collection_mod, only: function_space_collection
  use sci_geometric_constants_mod,   only: get_height_fv
  use mesh_mod,                      only: mesh_type
  use physics_mappings_alg_mod,      only: map_physics_winds, split_wind_alg
  use map_fd_to_prognostics_alg_mod, only: set_wind
  use planet_config_mod,             only: kappa, p_zero
  use timestepping_config_mod,       only: dt
  use horiz_mean_alg_mod,            only: horiz_mean_alg
  !> @todo Data passed to the kernel via module 'use' statements.
  !>       When PSyclone supports passing of arrays into kernels (issue #1312),
  !>       these data should be passed through the argument list of the invoke.
  use profile_interp_kernel_mod,     only: profile_interp_kernel_type, &
                                           profile_size,               &
                                           profile_data,               &
                                           profile_heights
  use prof_temporal_interp_mod,      only: prof_temporal_interp

  implicit none

  private
  public :: newton_damping_layer_alg

contains

  !> @brief Algorithm to calculate Newtonian relaxation of potential temperature
  !> @param[in,out] dtheta_forcing Relaxation increment
  !> @param[in,out] du_forcing Relaxation increment
  !> @param[in]     theta Dry potential temperature
  !> @param[in]     twod_mesh Information  about the horizontal mesh
  !> @param[in]     u Horizontal wind
  !> @param[in]     time_now Current model time in seconds
  subroutine newton_damping_layer_alg( dtheta_forcing, du_forcing, dmv_forcing, &
                            theta, u, mv, twod_mesh, time_now )    
  
  !TODO: Edit the rose-meta config definition
  use newton_damping_config_mod, only: number_times,                           &
                                    number_heights,                            &
                                    times,                                     &
                                    heights,                                   &
                                    theta_relax_data => theta_profile_data,    &
                                    u_relax_data => u_profile_data,            &
                                    v_relax_data => v_profile_data,            &
                                    w_relax_data => w_profile_data,            &
                                    mv_relax_data => mv_profile_data,          &
                                    newton_dl_base,                            &
                                    newton_dl_top,                             &
                                    newton_dl_scale_height,                    &
                                    sample_n_points,                           &
                                    timescale,                                 &
                                    damp_to_domain_mean

  implicit none
  
  ! Slow physics model increments to modify.
  type( field_type ), intent(inout)       :: dtheta_forcing
  type( field_type ), intent(inout)       :: du_forcing
  type( field_type ), intent(inout)       :: dmv_forcing

  ! Model prognostic fields for damping.
  type( field_type ), intent(in), target  :: theta !WTHETA
  type( field_type ), intent(in), target  :: u !W2 -> W3 + WTHETA
  type( field_type ), intent(in), target  :: mv !W3

  ! Auxillary variables
  type( mesh_type ),  intent(in), pointer :: twod_mesh
  real( kind=r_def ),    intent(in) :: time_now
  
  integer( kind=i_def )       :: nlayers
  real( kind=r_def )          :: dt_rdef

  ! Interpolated relaxation profiles
  real( kind=r_def )          :: theta_relax_now(number_heights)
  real( kind=r_def )          :: u_relax_now(number_heights)
  real( kind=r_def )          :: v_relax_now(number_heights)
  real( kind=r_def )          :: w_relax_now(number_heights)
  real( kind=r_def )          :: mv_relax_now(number_heights)

  ! Physics fields to unpack W2 function space winds into.
  type( field_type ), target  :: u_in_w3 
  type( field_type ), target  :: v_in_w3 
  type( field_type ), target  :: w_in_w3 
  type( field_type ), target  :: u_in_w2h 
  type( field_type ), target  :: v_in_w2h
  type( field_type ), target  :: w_in_wth
  
  ! Horizontal-mean prognostic fields
  type( field_type ), target  :: theta_horiz_mean
  type( field_type ), target  :: mv_horiz_mean
  type( field_type ), target  :: u_horiz_mean
  type( field_type ), target  :: v_horiz_mean
  type( field_type ), target  :: w_horiz_mean

  real( kind=r_def )          :: relaxation_coeff
  integer( kind=i_def )       :: i, k, mesh_id
  logical( kind=l_def )       :: profile_extrap

  ! Temporary arrays for calculating exponential profile
  real( kind=r_def ), allocatable   :: sample_exp_profile(:)
  real( kind=r_def ), allocatable   :: sample_heights(:)

  ! Exponential scaling profiles interpolated onto W3 and Wtheta levels
  type( field_type )          :: relaxation_coeff_w3
  type( field_type )          :: relaxation_coeff_wth
  
  ! Relaxation increments
  type( field_type )          :: dtheta_relax
  type( field_type )          :: dmv_relax
  ! w2 field for relaxation increments
  type( field_type )          :: du_relaxation_forcing
  ! Physics fields for wind relaxation components
  type( field_type )          :: du_relax ! W3
  type( field_type )          :: dv_relax ! W3
  type( field_type )          :: dw_relax ! Wtheta

  type( field_type ), pointer :: height_wth => null()
  type( field_type ), pointer :: height_w3 => null()
  type( mesh_type ),  pointer :: u_mesh

  ! Only apply relaxation between the specified times, unless only
  ! one time is specified. In the later case relaxation applies at all times.
  if ( number_times > 1 .and. &
       ( time_now < times(1) .or. time_now > times(number_times) ) ) return

  dt_rdef = real( dt, kind=r_def )
  
  ! Get mesh information needed for W2 function space
  write(*,*) 'Getting mesh id information'
  u_mesh => u%get_mesh()
  nlayers = u_mesh%get_nlayers()
  
  ! Initialise the temporary fields needed
  write(*,*) 'Initialising temporary fields function space'

  ! Theta and mv are ordinary scalars
  call dtheta_relax%initialise( vector_space = theta%get_function_space() )

  call dmv_relax%initialise( vector_space = mv%get_function_space() )
  
  ! W2 space relaxation increment
  call du_relaxation_forcing%initialise( vector_space = u%get_function_space() )
  
  ! Temporary fields for holding components
  call u_in_w3%initialise( vector_space = &
                function_space_collection%get_fs( u_mesh, 0, 0, W3 ) )

  call v_in_w3%initialise( vector_space = &
                function_space_collection%get_fs( u_mesh, 0, 0, W3 ) )

  call w_in_w3%initialise( vector_space = &
                function_space_collection%get_fs( u_mesh, 0, 0, W3 ) )

  ! Initialization following diagnostics_io_mod
  call u_in_w2h%initialise( vector_space = &
                function_space_collection%get_fs( u_mesh, 0, 0, W2H ) )

  call v_in_w2h%initialise( vector_space = &
                function_space_collection%get_fs( u_mesh, 0, 0, W2H ) )

  call w_in_wth%initialise( vector_space = &
                function_space_collection%get_fs( u_mesh, 0, 0, WTHETA ) )

  ! Initialise the relaxation coefficient fields on W3 and Wtheta levels
  call relaxation_coeff_w3%initialise( vector_space = &
                function_space_collection%get_fs( u_mesh, 0, 0, W3 ) )

  call relaxation_coeff_wth%initialise( vector_space = &
                function_space_collection%get_fs( u_mesh, 0, 0, WTHETA ) )
  
  ! Initialise the physics component relaxation increment fields
  call du_relax%initialise( vector_space = u_in_w3%get_function_space() )

  call dv_relax%initialise( vector_space = v_in_w3%get_function_space() )

  call dw_relax%initialise( vector_space = w_in_wth%get_function_space() )

  ! Map the actual w2 wind field to physics components
  call map_physics_winds( u_in_w3, v_in_w3, w_in_w3, u )
  ! Similar call but for w_in_wth specifically
  ! This is copied over from map_physics_winds_alg_mod
  call split_wind_alg(u_in_w2h, v_in_w2h, w_in_wth, &
                        u, u_mesh)

  if ( damp_to_domain_mean ) then
    ! Set the damping target to the domain mean of the prognostic field
    call u_horiz_mean%initialise( vector_space = u_in_w3%get_function_space() )
    call v_horiz_mean%initialise( vector_space = v_in_w3%get_function_space() )
    call w_horiz_mean%initialise( vector_space = w_in_wth%get_function_space() )
    call theta_horiz_mean%initialise( vector_space = theta%get_function_space() )
    call mv_horiz_mean%initialise( vector_space = mv%get_function_space() )
    ! Calculate the horizontal-mean profiles
    call horiz_mean_alg( u_horiz_mean, nlayers, twod_mesh, u_in_w3 )
    call horiz_mean_alg( v_horiz_mean, nlayers, twod_mesh, v_in_w3 )
    call horiz_mean_alg( w_horiz_mean, nlayers, twod_mesh, w_in_wth )
    call horiz_mean_alg( theta_horiz_mean, nlayers, twod_mesh, theta )
    call horiz_mean_alg( mv_horiz_mean, nlayers, twod_mesh, mv )

  else if ( number_times == 1 ) then
    ! This is what applies for a time-constant damping profile
    theta_relax_now(:) = theta_relax_data(:)
    u_relax_now(:) = u_relax_data(:)
    v_relax_now(:) = v_relax_data(:)
    w_relax_now(:) = w_relax_data(:)
    mv_relax_now(:) = mv_relax_data(:)
  else
    ! Interpolate the relaxation time series to current time
    call prof_temporal_interp( time_now, number_heights, number_times, times, &
                               theta_relax_data, theta_relax_now )
    call prof_temporal_interp( time_now, number_heights, number_times, times, &
                               u_relax_data, u_relax_now )
    call prof_temporal_interp( time_now, number_heights, number_times, times, &
                               v_relax_data, v_relax_now )
    call prof_temporal_interp( time_now, number_heights, number_times, times, &
                               w_relax_data, w_relax_now )
    call prof_temporal_interp( time_now, number_heights, number_times, times, &
                               mv_relax_data, mv_relax_now )
  end if

  write(*,*) 'Constructing height profile'
  ! Get height_w3 and height_wth fields. This is generally needed for interpolation
  ! of relaxation profiles but also for damping layer exponential scaling. 
  profile_size = number_heights
  ! Copy over the reference heights
  profile_heights( 1:profile_size ) = heights( 1:profile_size )

  ! Allow only height coordinates
  mesh_id = dtheta_relax%get_mesh_id()
  height_wth => get_height_fv( Wtheta, mesh_id )
  height_w3 => get_height_fv( W3, mesh_id )

  ! Exponential scaling profile
  ! Crude way to do this via interpolation; otherwise need a kernel function to
  ! explicitly loop over model levels.
  allocate( sample_exp_profile(sample_n_points) )
  allocate( sample_heights(sample_n_points) )
  sample_heights = [(i, i=0,sample_n_points-1)] * (real(newton_dl_top - newton_dl_base, kind=r_def) &
                    / real(sample_n_points-1, kind=r_def) + real(newton_dl_base, kind=r_def))
  sample_exp_profile = (exp( (sample_heights - real(newton_dl_base, kind=r_def)) &
                    / real(newton_dl_scale_height, kind=r_def) ) - 1)

  ! Interpolate the exponential profile to model levels
  profile_data( 1:sample_n_points ) = sample_exp_profile( 1:sample_n_points )
  profile_heights( 1:sample_n_points ) = sample_heights( 1:sample_n_points )
  profile_extrap = .false.

  relaxation_coeff = dt_rdef / timescale
  ! Calculate the damping coefficient profiles with exponential scaling on W3 and Wtheta levels
  write(*,*) 'Invoke call 1'
  call invoke( profile_interp_kernel_type( relaxation_coeff_w3, height_w3, profile_extrap ), &
               inc_a_times_X( relaxation_coeff, relaxation_coeff_w3 ) )
  write(*,*) 'Invoke call 2'
  call invoke( profile_interp_kernel_type( relaxation_coeff_wth, height_wth, profile_extrap ), &
               inc_a_times_X( relaxation_coeff, relaxation_coeff_wth ) )

  ! Its probably more elegant to use pointers to a damping target instead of repeating the code
  ! but this is easier to debug. Possible refactoring in the future.
  if ( damp_to_domain_mean ) then
    ! Set the damping target to the domain mean of the prognostic field
    ! Calculate the damping increments
    ! Note that in this case, the mean-profile is specified throughout the atmosphere
    ! but the damping extent is controlled solely by the exponential scaling profile.
    call invoke( setval_X( dtheta_relax, theta_horiz_mean ),     &
                 inc_X_minus_Y( dtheta_relax, theta ),             &
                 inc_X_times_Y( dtheta_relax, relaxation_coeff_wth ),  &
                 inc_X_plus_Y( dtheta_forcing, dtheta_relax ) )
    call invoke( setval_X( dmv_relax, mv_horiz_mean ),     &
                 inc_X_minus_Y( dmv_relax, mv ),             &
                 inc_X_times_Y( dmv_relax, relaxation_coeff_wth ),  &
                 inc_X_plus_Y( dmv_forcing, dmv_relax ) )
    ! Transform back to W2 space later for increments
    call invoke( setval_X( du_relax, u_horiz_mean ),        &
                 inc_X_minus_Y( du_relax, u_in_w3 ),               &
                 inc_X_times_Y( du_relax, relaxation_coeff_w3 ) )
    call invoke( setval_X( dv_relax, v_horiz_mean ),        &
                 inc_X_minus_Y( dv_relax, v_in_w3 ),               &
                 inc_X_times_Y( dv_relax, relaxation_coeff_w3 ) )
    call invoke( setval_X( dw_relax, w_horiz_mean ),        &
                 inc_X_minus_Y( dw_relax, w_in_wth ),               &
                 inc_X_times_Y( dw_relax, relaxation_coeff_wth ) )
    
  else if ( number_heights == 1 ) then
    ! Constant relaxation with height
    ! Calculate the relaxation increments
    write(*,*) 'Invoke call 3'
    call invoke( setval_c( dtheta_relax, theta_relax_now(1) ),     &
                 inc_X_minus_Y( dtheta_relax, theta ),             &
                 inc_X_times_Y( dtheta_relax, relaxation_coeff_wth ),  &
                 inc_X_plus_Y( dtheta_forcing, dtheta_relax ) )
    call invoke( setval_c( dmv_relax, mv_relax_now(1) ),     &
                 inc_X_minus_Y( dmv_relax, mv ),             &
                 inc_X_times_Y( dmv_relax, relaxation_coeff_w3 ),  &
                 inc_X_plus_Y( dmv_forcing, dmv_relax ) )
    ! Transform back to W2 space later for increments
    write(*,*) 'Invoke call 4'
    call invoke( setval_c( du_relax, u_relax_now(1) ),        &
                 inc_X_minus_Y( du_relax, u_in_w3 ),               &
                 inc_X_times_Y( du_relax, relaxation_coeff_w3 ) )
    write(*,*) 'Invoke call 5'
    call invoke( setval_c( dv_relax, v_relax_now(1) ),        &
                 inc_X_minus_Y( dv_relax, v_in_w3 ),               &
                 inc_X_times_Y( dv_relax, relaxation_coeff_w3 ) )
    write(*,*) 'Invoke call 6'
    call invoke( setval_c( dw_relax, w_relax_now(1) ),        &
                 inc_X_minus_Y( dw_relax, w_in_wth ),               &
                 inc_X_times_Y( dw_relax, relaxation_coeff_wth ) )

  else
    ! Specified relaxation profile with height
    ! Copy over theta_relax profile to module global profile_data for interpolation kernel
    profile_size = number_heights
    profile_data( 1:profile_size ) = theta_relax_now( 1:profile_size )
    profile_extrap = .false.
    write(*,*) 'Invoke call 7'
    call invoke( setval_X( dtheta_relax, theta),                  &
                 profile_interp_kernel_type( dtheta_relax, height_wth, &
                                             profile_extrap ),         &
                 inc_X_minus_Y( dtheta_relax, theta ),                 &
                 inc_X_times_Y( dtheta_relax, relaxation_coeff_wth ),      &
                 inc_X_plus_Y( dtheta_forcing, dtheta_relax ) )

    ! Repeat for mv with wth heights
    profile_data( 1:profile_size ) = mv_relax_now( 1:profile_size )
    profile_extrap = .false.
    call invoke( setval_X( dmv_relax, mv),                  &
                 profile_interp_kernel_type( dmv_relax, height_wth, &
                                             profile_extrap ),         &
                 inc_X_minus_Y( dmv_relax, mv ),                 &
                 inc_X_times_Y( dmv_relax, relaxation_coeff_wth ),      &
                 inc_X_plus_Y( dmv_forcing, dmv_relax ) )

    ! Repeat for u-wind but with W3 heights
    profile_data( 1:profile_size ) = u_relax_now( 1:profile_size )
    profile_extrap = .false.
    write(*,*) 'Invoke call 8'
    call invoke( setval_X( du_relax, u_in_w3),                  &
                 ! Write interpolated profile to du_relax
                 profile_interp_kernel_type( du_relax, height_w3, &
                                             profile_extrap ),         &
                 ! Find the difference; this is zero for levels outside of profile range
                 inc_X_minus_Y( du_relax, u_in_w3 ),            &
                 inc_X_times_Y( du_relax, relaxation_coeff_w3 ) )
    
    ! Now repeat for v-wind but with W3 heights
    profile_data( 1:profile_size ) = v_relax_now( 1:profile_size )
    profile_extrap = .false.
    write(*,*) 'Invoke call 9'
    call invoke( setval_X( dv_relax, v_in_w3),                  &
                 profile_interp_kernel_type( dv_relax, height_w3, &
                                             profile_extrap ),         &
                 inc_X_minus_Y( dv_relax, v_in_w3 ),            &
                 inc_X_times_Y( dv_relax, relaxation_coeff_w3 ) )

    ! Now repeat for w-wind but with Wth heights
    profile_data( 1:profile_size ) = w_relax_now( 1:profile_size )
    profile_extrap = .false.
    write(*,*) 'Invoke call 10'
    call invoke( setval_X( dw_relax, w_in_wth),                  &
                 profile_interp_kernel_type( dw_relax, height_wth, &
                                             profile_extrap ),         &
                 inc_X_minus_Y( dw_relax, w_in_wth ),            &
                 inc_X_times_Y( dw_relax, relaxation_coeff_wth ) )

  end if

  ! Transform the relaxation increments back to w2 space
  call set_wind( du_relaxation_forcing, du_relax, dv_relax, dw_relax)
    ! Add relaxation increments to forcing
  write(*,*) 'Invoke call 11'
  call invoke( inc_X_plus_Y( du_forcing, du_relaxation_forcing ) ) 

  end subroutine newton_damping_layer_alg
end module newton_damping_layer_alg_mod
